# TGZ 的用户安装脚本放在解压根目录；DEB/RPM 不携带此手动入口。
if(CPACK_GENERATOR STREQUAL "TGZ")
  file(INSTALL "@CMAKE_SOURCE_DIR@/packaging/linux/install.sh"
       DESTINATION "${CPACK_TEMPORARY_DIRECTORY}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
